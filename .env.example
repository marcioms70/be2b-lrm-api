PORT=3000
NODE_ENV=production

DATABASE_URL=postgresql://be2b_lrm_user:SUA_SENHA@172.16.1.10:5432/be2b_lrm

CORS_ORIGIN=*
FRONTEND_URL=https://SEU_FRONTEND_LOVABLE

UPLOAD_DIR=/app/uploads
MEDIA_PUBLIC_BASE_URL=https://api.be2b.tech
MAX_IMAGE_MB=10
MAX_PDF_MB=20
MAX_VIDEO_MB=100

OPENAI_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.be2b.tech/api/meta-ads/oauth/callback
META_GRAPH_API_VERSION=v21.0
META_ENCRYPTION_KEY=
META_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement,instagram_basic

# --- Autenticação (OBRIGATÓRIO em produção) ---
# Projeto Supabase (Lovable Cloud) usado pelo be2bdr. Sem estas duas variáveis a API fica ABERTA.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# enforce (padrão) | log (só registra, não bloqueia — use para validar a virada) | off
API_AUTH_MODE=enforce
# Opcional: segredo exigido (header x-webhook-secret) nos endpoints de lead de entrada
INBOUND_WEBHOOK_SECRET=

# --- Sincronização de métricas da Meta ---
# Intervalo da sincronização automática em horas (0 desliga; padrão 6)
META_INSIGHTS_AUTO_SYNC_HOURS=6

# --- Regras automáticas ---
# Intervalo de avaliação em minutos (0 desliga; padrão 60)
RULES_EVAL_INTERVAL_MINUTES=60
# false = regras com ação "pausar" apenas notificam
RULES_ALLOW_PAUSE=true
RULES_TIMEZONE=America/Sao_Paulo
